{{{
  exports({ to: app.configPath('password_confirmations.ts') })
}}}
import { defineConfig } from '@kevinjohn/adonisjs-confirm-action-with-password'

/**
 * Confirmations need Account Kit session login (authentication.strategy: 'session') with
 * sessionManagement enabled, and a server-side session store (not the cookie store).
 */
export default defineConfig({
  /**
   * How long a confirmation stays spendable after the password check.
   */
  window: '5m',

  /**
   * The confirmations table; must match the generated migration.
   */
  table: '{{{ tableName }}}',

  /**
   * The users table Account Kit manages; must match the generated migration.
   */
  usersTable: '{{{ usersTable }}}',

  /**
   * Wrong passwords allowed per account through @adonisjs/limiter before it is blocked.
   * Set to false only if the issuance route throttles them itself.
   */
  throttle: { requests: 5, duration: '1 minute', blockDuration: '20 minutes' },

  /**
   * Host policy, re-run under the Account Kit lock at issuance and at spend. Return false to
   * refuse, for example while masquerading or for anyone but the resource owner.
   */
  authorize: async () => true,
})
